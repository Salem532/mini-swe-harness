# LiteLLM / OpenAI-compatible endpoint (local vLLM on this machine)
LITELLM_MODEL=openai/qwen
OPENAI_API_BASE=http://127.0.0.1:8000/v1
OPENAI_API_KEY=dummy

# mini-swe-agent cost tracking for unregistered local models
MSWEA_COST_TRACKING=ignore_errors

# Optional override of the checkout root inside containers
# MINI_SWE_HARNESS_ROOT=/opt/harness

# mcp-call talks to the episode gateway
# MCP_GATEWAY_URL=http://gateway:8765/mcp
